; Engine configuration file.
config_version=5

[application]

config/name="WILDBOUND: Primal Age"
config/description="First-person prehistoric survival (Phase 1 graybox)."
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://assets/icons/T_AppIcon_1024.png"
config/macos_native_icon="res://assets/icons/WILDBOUND.icns"

[autoload]

Events="*res://autoload/events.gd"
Loc="*res://autoload/localization.gd"
ItemDB="*res://autoload/item_db.gd"
Settings="*res://autoload/settings.gd"
SaveManager="*res://autoload/save_manager.gd"
Game="*res://autoload/game.gd"
Sfx="*res://autoload/sfx.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

common/drop_mouse_on_gui_input_disabled=true

[internationalization]

locale/fallback="ru"

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="soft_interactable"
3d_physics/layer_4="water"
3d_physics/layer_5="creature"

[rendering]

renderer/rendering_method="forward_plus"
anti_aliasing/quality/use_taa=true
textures/default_filters/anisotropic_filtering_level=3
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2
lights_and_shadows/directional_shadow/size=4096

[shader_globals]

wind_strength={
"type": "float",
"value": 0.3
}
wind_direction={
"type": "vec2",
"value": Vector2(0.8, 0.6)
}
